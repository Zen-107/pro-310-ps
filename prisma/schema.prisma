generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Exercise {
  id             String   @id @default(cuid())
  name           String
  nameTh         String
  category       String   // "knee", "shoulder", "hip", "back", "neck", "ankle"
  description    String
  instructions   String   // JSON array of step-by-step instructions
  targetJoints   String   // JSON: [{name, idealAngle, minAngle, maxAngle}]
  difficulty     String   @default("beginner") // "beginner", "intermediate", "advanced"
  sets           Int      @default(3)
  repsPerSet     Int      @default(10)
  restSeconds    Int      @default(30)
  icon           String   @default("Activity")
  bodyPart       String   // "lower", "upper", "full"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
}

model Patient {
  id                  String   @id @default(cuid())
  name                String
  age                 Int?
  gender              String   @default("ไม่ระบุ") // "ชาย", "หญิง", "ไม่ระบุ"
  condition           String   @default("") // อาการ/โรค เช่น "ปวดเข่าเรื้อรัง"
  phone               String   @default("")
  assignedExerciseIds String   @default("[]") // JSON array of exercise IDs
  therapistNotes      String   @default("") // หมอบันทึก
  streak              Int      @default(0)
  totalMinutes        Int      @default(0)
  lastActiveAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  sessions            Session[]
}

model Session {
  id           String   @id @default(cuid())
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  totalReps    Int      @default(0)
  avgAccuracy  Float    @default(0)
  maxRom       Float    @default(0)
  status       String   @default("in_progress") // "in_progress", "completed", "cancelled"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         JointAngleLog[]
}

model JointAngleLog {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  repNumber Int      @default(0)
  timestamp DateTime @default(now())
  jointName String
  angle     Float
  idealAngle Float
  deviation Float
  isCorrect Boolean  @default(false)
}