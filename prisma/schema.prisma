// AI Physio — PostgreSQL schema
// Hierarchy: Organization → Clinician (doctor/PT) ↔ Patient → Prescription → Quest → ExerciseSession
// Migrations: `bun run db:migrate` (dev) / `bun run db:migrate:deploy` (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────
// Exercise category / body part / difficulty / joint names use lowercase
// values so they match the keys the client already uses (e.g. "left_knee").

enum OrgType {
  HOSPITAL
  CLINIC
}

enum UserRole {
  ADMIN
  CLINICIAN
  PATIENT
}

enum ClinicianTitle {
  DOCTOR
  PHYSIOTHERAPIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum CareRole {
  PRIMARY
  SUPPORTING
}

enum ExerciseCategory {
  knee
  shoulder
  hip
  back
  neck
  ankle
}

enum BodyPart {
  upper
  lower
  full
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum ExerciseStatus {
  DRAFT // not assignable (e.g. unverified source or not measurable yet)
  PUBLISHED
  RETIRED
}

// Measurement keys produced by calculateAllAngles() (formulas in src/lib/joint-formulas.ts).
// LEGACY (no longer measured or seeded, kept so old rows stay valid):
// left/right_shoulder_extension, left/right_ankle, neck, spine_flexion
enum JointName {
  left_knee
  right_knee
  left_hip
  right_hip
  left_hip_flexion
  right_hip_flexion
  hip_opening
  left_shoulder
  right_shoulder
  left_shoulder_extension
  right_shoulder_extension
  left_elbow
  right_elbow
  left_ankle
  right_ankle
  neck
  spine_flexion
  left_hip_abduction
  right_hip_abduction
  trunk_lateral_flexion
  trunk_inclination
  trunk_rotation
}

// Form problems detected during a session
enum FaultType {
  INCOMPLETE_ROM // movement toward the target that never reached the range
  COMPENSATION // a form check failed at the rep's best moment (e.g. knee bent in SLR)
  LOW_ACCURACY // counted rep scored below the accuracy threshold
}

// Where a target angle came from — shown to clinicians for transparency
enum AngleBasis {
  DEVELOPER_ESTIMATE
  SOURCE_STATED
  GROUND_TRUTH_EXTRACTED
  CLINICIAN_SET
}

enum SourceType {
  PATIENT_EDUCATION
  CLINICAL_GUIDELINE
  JOURNAL_ARTICLE
  TEXTBOOK
  VIDEO
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerifierType {
  CLINICIAN
  DEVELOPER
}

// How closely the cited source matches the app's exercise
enum ReferenceRelevance {
  EXACT
  CLOSE
  PARTIAL
}

enum PrescriptionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  APPROVED
  NEEDS_ATTENTION
}

// ─── Organization & people ──────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicians Clinician[]
  patients   Patient[]

  @@map("organizations")
}

// Login identity (Credentials auth). Clinician/Patient hold the profile.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinician    Clinician?
  patient      Patient?
  sentMessages CareMessage[]
  threadReads  CareThreadRead[]

  @@map("users")
}

model Clinician {
  id             String         @id @default(cuid())
  userId         String         @unique
  organizationId String
  title          ClinicianTitle
  licenseNumber  String?
  specialty      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  careAssignments    CareAssignment[]
  prescriptions      Prescription[]
  reviews            SessionReview[]
  verifiedSources    ExerciseSource[]
  prescribedSessions ExerciseSession[]

  @@index([organizationId])
  @@map("clinicians")
}

model Patient {
  id             String    @id @default(cuid())
  userId         String?   @unique
  organizationId String
  name           String
  hn             String? // Hospital Number, unique within the organization
  dateOfBirth    DateTime? @db.Date
  gender         Gender    @default(UNSPECIFIED)
  condition      String?
  phone          String?
  clinicalNotes  String? // care-team notes, never shown to the patient
  consentVersion String? // PDPA consent record
  consentAt      DateTime?
  // Separate, explicit consent to record session video (PDPA sensitive data).
  // null = not given or withdrawn; recording is refused server-side without it.
  videoConsentVersion String?
  videoConsentAt      DateTime?
  archivedAt     DateTime? // medical records are archived, never hard-deleted
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  careAssignments CareAssignment[]
  prescriptions   Prescription[]
  quests          Quest[]
  sessions        ExerciseSession[]
  messages        CareMessage[]
  threadReads     CareThreadRead[]

  @@unique([organizationId, hn])
  @@index([organizationId])
  @@map("patients")
}

model CareAssignment {
  patientId   String
  clinicianId String
  role        CareRole @default(PRIMARY)
  assignedAt  DateTime @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinician Clinician @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  @@id([patientId, clinicianId])
  @@index([clinicianId])
  @@map("care_assignments")
}

// ─── Exercise library & citations ───────────────────────────────────

model Exercise {
  id                 String           @id @default(cuid())
  slug               String           @unique // stable key, e.g. "ex_knee_flexion"
  name               String
  nameTh             String
  category           ExerciseCategory
  bodyPart           BodyPart
  difficulty         Difficulty       @default(beginner)
  description        String
  instructions       Json // string[]
  defaultSets        Int              @default(3)
  defaultReps        Int              @default(10)
  defaultRestSeconds Int              @default(30)
  icon               String           @default("Activity")
  status             ExerciseStatus   @default(DRAFT)
  statusNote         String? // why it is DRAFT/RETIRED
  formChecks         Json             @default("[]") // compensation checks, see src/lib/form-checks.ts
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  targets           ExerciseJointTarget[]
  references        ExerciseReference[]
  measurements      ReferenceMeasurement[]
  prescriptionItems PrescriptionItem[]
  sessions          ExerciseSession[]

  @@index([status, category])
  @@map("exercises")
}

model ExerciseJointTarget {
  id         String     @id @default(cuid())
  exerciseId String
  joint      JointName
  nameTh     String
  idealAngle Float
  minAngle   Float
  maxAngle   Float
  isPrimary  Boolean    @default(false) // drives rep counting (one per exercise, enforced in API)
  formula    String? // e.g. "angle(hip, knee, ankle)"; null = not measurable by the angle engine
  angleBasis AngleBasis @default(DEVELOPER_ESTIMATE)
  rationale  String? // why this target was chosen (shown to clinicians)
  sourceId   String? // citation for the angle itself, when one exists

  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  source   ExerciseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([exerciseId, joint])
  @@map("exercise_joint_targets")
}

model ExerciseSource {
  id                    String             @id @default(cuid())
  sourceType            SourceType
  title                 String
  url                   String             @unique
  institution           String
  authors               String? // contributors / reviewers as printed on the source
  language              String             @default("en")
  publishedAt           DateTime?
  accessedAt            DateTime
  verificationStatus    VerificationStatus @default(PENDING)
  verifiedByType        VerifierType?
  verifiedByName        String?
  verifiedByClinicianId String?
  verifiedAt            DateTime?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  verifiedByClinician Clinician?             @relation(fields: [verifiedByClinicianId], references: [id], onDelete: SetNull)
  references          ExerciseReference[]
  measurements        ReferenceMeasurement[]
  jointTargets        ExerciseJointTarget[]

  @@index([verificationStatus])
  @@map("exercise_sources")
}

model ExerciseReference {
  exerciseId         String
  sourceId           String
  relevance          ReferenceRelevance
  sourceExerciseName String // the exercise's name as written in the source
  note               String?

  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  source   ExerciseSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([exerciseId, sourceId])
  @@map("exercise_references")
}

// Angles extracted from a (verified) source video by the ground-truth pipeline
model ReferenceMeasurement {
  id               String    @id @default(cuid())
  sourceId         String
  exerciseId       String
  joint            JointName
  measuredAngle    Float
  sampleCount      Int
  videoStartSec    Float?
  videoEndSec      Float?
  extractorVersion String
  extractedAt      DateTime  @default(now())

  source   ExerciseSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@map("reference_measurements")
}

// ─── Prescriptions & daily quests ───────────────────────────────────

model Prescription {
  id          String             @id @default(cuid())
  patientId   String
  clinicianId String
  title       String
  notes       String?
  startDate   DateTime           @db.Date
  endDate     DateTime?          @db.Date
  status      PrescriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinician Clinician          @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  items     PrescriptionItem[]
  sessions  ExerciseSession[]

  @@index([patientId, status])
  @@index([clinicianId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  exerciseId     String
  sets           Int
  repsPerSet     Int
  restSeconds    Int
  daysOfWeek     Int[] // 0 = Sunday … 6 = Saturday; empty = every day
  sortOrder      Int     @default(0)
  notes          String?

  prescription    Prescription                 @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  exercise        Exercise                     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  targetOverrides PrescriptionTargetOverride[]
  quests          Quest[]
  sessions        ExerciseSession[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// Per-patient angle targets; joints not overridden fall back to ExerciseJointTarget
model PrescriptionTargetOverride {
  itemId     String
  joint      JointName
  idealAngle Float
  minAngle   Float
  maxAngle   Float

  item PrescriptionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, joint])
  @@map("prescription_target_overrides")
}

// One row per prescription item per due day (created lazily when the patient opens the app)
model Quest {
  id                 String      @id @default(cuid())
  prescriptionItemId String
  patientId          String
  dueDate            DateTime    @db.Date
  status             QuestStatus @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime    @default(now())

  prescriptionItem PrescriptionItem  @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessions         ExerciseSession[]

  @@unique([prescriptionItemId, dueDate])
  @@index([patientId, dueDate])
  @@map("quests")
}

// ─── Session results & clinician verification ───────────────────────

model ExerciseSession {
  id                 String        @id @default(cuid())
  patientId          String
  exerciseId         String
  questId            String? // set for every new session (free practice is disabled)
  // Denormalized from the quest at start, so clinician views need no joins
  prescriptionId     String?
  prescriptionItemId String?
  clinicianId        String? // prescribing clinician
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  status             SessionStatus @default(IN_PROGRESS)
  totalReps          Int           @default(0)
  avgAccuracy        Float         @default(0)
  romMinAngle        Float?
  romMaxAngle        Float?
  romDegrees         Float? // romMaxAngle − romMinAngle of the primary joint
  primaryJoint       JointName?
  targetSnapshot     Json // exact targets (incl. overrides + formulas) used at runtime
  algorithmVersion   String // e.g. "angle-utils@2", for reproducibility
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  exercise         Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  quest            Quest?            @relation(fields: [questId], references: [id], onDelete: SetNull)
  prescription     Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  clinician        Clinician?        @relation(fields: [clinicianId], references: [id], onDelete: SetNull)
  reps             SessionRep[]
  logs             JointAngleLog[]
  faults           SessionFault[]
  review           SessionReview?
  reports          ClinicalReport[]
  frameChunks      SessionFrameChunk[]
  video            SessionVideo?

  @@index([patientId, startedAt])
  @@index([questId])
  @@index([prescriptionId])
  @@index([clinicianId, status])
  @@map("exercise_sessions")
}

model SessionRep {
  id         String   @id @default(cuid())
  sessionId  String
  setNumber  Int
  repNumber  Int // 1…N across the whole session
  enteredAt  DateTime
  durationMs Int
  bestAngle  Float
  accuracy   Float
  isCorrect  Boolean  @default(true) // false when the rep has COMPENSATION / LOW_ACCURACY faults

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs    JointAngleLog[]
  faults  SessionFault[]

  @@unique([sessionId, repNumber])
  @@map("session_reps")
}

model SessionFault {
  id            String    @id @default(cuid())
  sessionId     String
  repId         String? // null for INCOMPLETE_ROM (no rep was counted)
  type          FaultType
  checkId       String? // form-check id for COMPENSATION
  joint         JointName
  measuredAngle Float
  expectedMin   Float?
  expectedMax   Float?
  deficit       Float? // degrees short of / beyond the expected range
  message       String
  occurredAt    DateTime

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rep     SessionRep?     @relation(fields: [repId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("session_faults")
}

model JointAngleLog {
  id         String    @id @default(cuid())
  sessionId  String
  repId      String?
  joint      JointName
  angle      Float
  idealAngle Float
  minAngle   Float
  maxAngle   Float
  deviation  Float
  isCorrect  Boolean
  timestamp  DateTime  @default(now())

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rep     SessionRep?     @relation(fields: [repId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("joint_angle_logs")
}

// Recorded pose landmarks for clinical session replay, uploaded in chunks
// of ~5 s. `frames` is ReplayFrame[] (format in src/lib/replay.ts).
model SessionFrameChunk {
  id        String   @id @default(cuid())
  sessionId String
  seq       Int // client chunk sequence number (idempotent re-upload)
  startedAt DateTime // first frame time
  frames    Json

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@map("session_frame_chunks")
}

// Session video recorded with the patient's video consent, uploaded in
// sequential chunks and stored outside the web root (VIDEO_STORAGE_DIR).
model SessionVideo {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  storageKey     String // file name inside VIDEO_STORAGE_DIR
  mimeType       String
  sizeBytes      Int       @default(0)
  chunkCount     Int       @default(0)
  recordStartAt  DateTime // wall-clock time of the first video frame (replay sync)
  consentVersion String // patient's video consent version at recording time
  completedAt    DateTime? // null while uploading or if the upload was cut off
  pauses         Json      @default("[]") // [{ at, resumedAt }] epoch ms: recording paused with the session
  createdAt      DateTime  @default(now())

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_videos")
}

model SessionReview {
  id          String       @id @default(cuid())
  sessionId   String       @unique
  clinicianId String
  status      ReviewStatus
  comment     String?
  reviewedAt  DateTime     @default(now())

  session   ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clinician Clinician       @relation(fields: [clinicianId], references: [id], onDelete: Restrict)

  @@index([clinicianId])
  @@map("session_reviews")
}

// Stored AI clinical summary (the Reporter agent's output)
model ClinicalReport {
  id          String   @id @default(cuid())
  sessionId   String
  content     String // markdown
  model       String
  generatedAt DateTime @default(now())

  session ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("clinical_reports")
}

// ─── Care-team chat ─────────────────────────────────────────────────
// One thread per patient, shared by the patient and every clinician in
// their care team (CareAssignment).

// CARE_TEAM = normal message; ASSISTANT_QUESTION = patient asked the AI companion;
// ASSISTANT_REPLY = AI companion answer (no sender). All kinds stay in the
// thread so the care team can see what the assistant told the patient.
enum MessageKind {
  CARE_TEAM
  ASSISTANT_QUESTION
  ASSISTANT_REPLY
}

model CareMessage {
  id        String      @id @default(cuid())
  patientId String // the thread
  senderId  String? // User (patient or clinician); null for ASSISTANT_REPLY
  kind      MessageKind @default(CARE_TEAM)
  escalated Boolean     @default(false) // assistant detected red-flag symptoms
  model     String? // AI model for ASSISTANT_REPLY
  body      String
  createdAt DateTime    @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sender  User?   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("care_messages")
}

// Per-user read position in a patient's thread (for unread counts)
model CareThreadRead {
  patientId  String
  userId     String
  lastReadAt DateTime

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([patientId, userId])
  @@map("care_thread_reads")
}
