# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Local: `docker compose up -d db` starts a matching Postgres on :5432.
# Use 127.0.0.1, not localhost: on Windows, Prisma may try IPv6 (::1), which Docker does not forward.
# Production: use your provider's connection string (Neon, Supabase, Railway, RDS …).
DATABASE_URL="postgresql://physio:physio@127.0.0.1:5432/ai_physio?schema=public"

# ─── Auth (next-auth) ────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ─── Seed (development only) ─────────────────────────────────────────
# Password given to every demo account created by `bun run db:seed`.
SEED_DEMO_PASSWORD="physio-demo-2026"

# ─── AI (coach, clinical reports, trend analysis, patient companion) ──
# Any OpenAI-compatible provider works; set at least ONE key below. With
# several keys, the agent tries them in this order (or AI_PROVIDER first) and
# falls through to the next one if a provider is rate-limited or down.
# With no key, AI features degrade gracefully (fixed coach messages, computed
# trends without a narrative, "assistant unavailable" in chat).
# Never commit real keys — put them in .env (git-ignored).

# Optional: provider to try first — gemini | groq | openrouter | openai
# AI_PROVIDER="gemini"

# 1) Google Gemini — free tier, best Thai quality. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"

# 2) Groq — free tier (no card), very fast. Key: https://console.groq.com/keys
#    Note: Llama models left Groq's free tier on 2026-08-16; gpt-oss / Qwen remain free.
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"

# 3) OpenRouter — free ":free" models at $0. Key: https://openrouter.ai/keys
#    "openrouter/free" routes to an available free model; pin one for consistent output,
#    e.g. "meta-llama/llama-3.3-70b-instruct:free" (see https://openrouter.ai/collections/free-models).
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openrouter/free"

# 4) OpenAI or any OpenAI-compatible server (paid OpenAI, or zero-cost local Ollama / LM Studio).
#    Local Ollama example: OPENAI_BASE_URL="http://127.0.0.1:11434/v1", OPENAI_API_KEY="ollama", OPENAI_MODEL="qwen3:8b"
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Optional tuning
# AI_REASONING_EFFORT="low"   # thinking models: minimal | low | medium | high | off (don't send)
# AI_TIMEOUT_MS="30000"
