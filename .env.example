# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Local: `docker compose up -d db` starts a matching Postgres on :5432.
# Production: use your provider's connection string (Neon, Supabase, Railway, RDS …).
DATABASE_URL="postgresql://physio:physio@localhost:5432/ai_physio?schema=public"

# ─── Auth (next-auth) ────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ─── Seed (development only) ─────────────────────────────────────────
# Password given to every demo account created by `bun run db:seed`.
SEED_DEMO_PASSWORD="physio-demo-2026"
